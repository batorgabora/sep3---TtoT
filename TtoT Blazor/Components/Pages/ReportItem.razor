@page "/items/report"
@using TtoT_Blazor.Models
@using TtoT_Blazor.Services
@inject IItemService ItemService
@inject SimpleAuthProvider AuthProvider
@inject NavigationManager NavigationManager

<PageTitle>report item</PageTitle>

<h3>report item</h3>

<div class="t2t-form">
    <div class="form-row">
        <label for="name">name:</label>
        <input id="name" type="text" @bind="item.Name" placeholder="beep boop" />
    </div>

    <div class="form-row">
        <label for="description">description:</label>
        <input id="description" type="text" @bind="item.Description" placeholder="some beeps some boops" />
    </div>

    <div class="form-row">
        <label for="category">category id:</label>
        <input id="category" type="number" min="1" @bind="item.CategoryId" />
        <span class="hint">a number from the category table, for now</span>
    </div>

    <div class="form-row">
        <label for="location">location:</label>
        <input id="location" type="text" @bind="item.Location" placeholder="horsens, by the station" />
    </div>

    <div class="form-row">
        <label for="latitude">latitude:</label>
        <input id="latitude" type="number" step="any" @bind="item.Latitude" placeholder="55.861" />
        <span class="hint">decimal degrees, between -90 and 90</span>
    </div>

    <div class="form-row">
        <label for="longitude">longitude:</label>
        <input id="longitude" type="number" step="any" @bind="item.Longitude" placeholder="9.850" />
        <span class="hint">decimal degrees, between -180 and 180</span>
    </div>

    <div class="form-actions">
        <button class="btn-main" @onclick="ReportAsync">report item</button>
        <button class="btn-quiet" @onclick='() => NavigationManager.NavigateTo("/items")'>cancel</button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="validation-message form-error">@errorMessage</p>
    }
</div>

@code {
    private CreateItemDto item = new();
    private string? errorMessage;

    private async Task ReportAsync()
    {
        errorMessage = null;

        int? userId = AuthProvider.GetCurrentUserId();
        if (userId == null)
        {
            errorMessage = "you must be logged in to report an item";
            return;
        }
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            errorMessage = "name is required";
            return;
        }
        if (item.CategoryId <= 0)
        {
            errorMessage = "category id must be 1 or higher";
            return;
        }
        if (item.Latitude == null || item.Longitude == null)
        {
            errorMessage = "latitude and longitude are required";
            return;
        }
        if (item.Latitude < -90 || item.Latitude > 90 || item.Longitude < -180 || item.Longitude > 180)
        {
            errorMessage = "latitude must be between -90 and 90, longitude between -180 and 180";
            return;
        }

        item.UploaderId = userId.Value;

        try
        {
            string? error = await ItemService.CreateAsync(item);
            if (error == null)
            {
                NavigationManager.NavigateTo("/items");
            }
            else
            {
                errorMessage = error;
            }
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }
}